spring:
  profiles:
    - mysql
#  config:
#    activate:
#      on-profile:
#        - mysql
##        - h2
##        - postgres
  jpa:
#    show-sql: true
    generate-ddl: true
    open-in-view: false
    hibernate:
      ddl-auto: create
    properties:
      hibernate:
#        '[generate_statistics]': true
        '[format_sql]': true

  ###########
  # devtools
  ###########
  devtools:
    restart:
      enabled: true


logging:
  level:
    root: info
    '[org.hibernate.sql]': debug
    '[org.hibernate.type.descriptor.sql.BasicBinder]': trace
